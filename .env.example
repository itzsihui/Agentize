# Base Sepolia (EthGlobal Tokyo — USDC x402)
BASE_RPC_URL=https://sepolia.base.org
BASE_NETWORK=eip155:84532
CHAIN_ID=84532
# Circle USDC on Base Sepolia
TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
TOKEN_SYMBOL=USDC
TOKEN_DECIMALS=6
# Merchant payTo (0x…) — bind via MetaMask on /merchant/setup
MERCHANT_ADDRESS=
# Buyer EOA private key for server-side agent settle (never commit real keys)
BUYER_PRIVATE_KEY=
BUYER_ADDRESS=
EXPLORER_BASE=https://sepolia.basescan.org
# Public Coinbase x402 testnet facilitator
X402_FACILITATOR_URL=https://x402.org/facilitator
OPENAI_API_KEY=

# Firebase (buyer + merchant auth / Firestore — public web config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# World ID (IDKit) — merchant storefront verification (one person, one storefront)
# From https://developer.world.org : app id + RP id + RP signing key
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
# staging = World ID Simulator (https://simulator.worldcoin.org); production = World App
NEXT_PUBLIC_WORLD_ENV=staging
# Server only — never expose
WORLD_RP_SIGNING_KEY=
# Server only — staging window token from the Developer Portal
# (set_world_id_staging_verification, valid 24h). Needed for Simulator proofs.
WORLD_STAGING_VERIFICATION_TOKEN=

# Intercepta (EthGlobal — free key at https://intercepta.io/ethglobal)
INTERCEPTA_API_KEY=
INTERCEPTA_BASE_URL=https://api.web3antivirus.io
# fail-closed: missing key / API error refuses settle
INTERCEPTA_FAIL_OPEN=false
# Show buyer risk-persona picker (honest vs Discord-pinned malicious)
NEXT_PUBLIC_INTERCEPTA_DEMO=true
INTERCEPTA_DEMO_MODE=true
# Optional JSON array: [{"id":"sanctioned","label":"Sanctioned","address":"0x…","blurb":"…"}]
# INTERCEPTA_DEMO_PERSONAS=
# Script fallback only — UI persona picker is the demo path
# INTERCEPTA_FORCE_SCREEN_ADDRESS=
